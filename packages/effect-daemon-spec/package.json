{
  "name": "@systemfsoftware/effect-daemon-spec",
  "license": "Apache-2.0",
  "version": "6.0.3",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/effect-daemon.git",
    "directory": "packages/effect-daemon-spec"
  },
  "homepage": "https://github.com/systemfsoftware/effect-daemon/tree/main/packages/effect-daemon-spec#readme",
  "bugs": "https://github.com/systemfsoftware/effect-daemon/issues",
  "description": "Supervision-tree daemons for Effect-TS — leader election, distributed locks, restart-intensity backoff, dynamic children, and health latches as a pure typed core.",
  "keywords": [
    "effect",
    "effect-ts",
    "daemon",
    "supervisor",
    "supervision-tree",
    "leader-election",
    "distributed-lock",
    "restart",
    "backoff",
    "fault-tolerance",
    "actor",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsdown -l warn && pnpm api:check",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:types": "TSTYCHE_TYPESCRIPT_MODULE=tstyche-typescript tstyche",
    "mutation": "stryker run",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "api:check": "api-extractor-quiet run",
    "api:update": "api-extractor run --local",
    "attw": "attw --pack ."
  },
  "dependencies": {
    "@systemfsoftware/effect-cell-types": "^12.0.2"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/conformance-spec": "^1.0.1",
    "@systemfsoftware/effect-gherkin-spec": "^8.0.0",
    "@systemfsoftware/effect-schema-law": "^6.1.0",
    "@systemfsoftware/effect-schema-vite": "^3.1.1",
    "@systemfsoftware/effect-spec-runtime": "^1.1.0",
    "@systemfsoftware/oxlint-config-recommended": "^5.0.0",
    "@systemfsoftware/stryker-config": "^0.2.0",
    "@systemfsoftware/stryker-ignorer-effect-schema-declarations": "catalog:stryker",
    "@systemfsoftware/stryker-ignorer-in-source-vitest-block": "catalog:stryker",
    "@systemfsoftware/stryker-js": "catalog:stryker",
    "@systemfsoftware/stryker-js-typescript-checker": "catalog:stryker",
    "@systemfsoftware/stryker-js-vitest-runner": "catalog:stryker",
    "@systemfsoftware/tsconfig": "^2.0.2",
    "@systemfsoftware/tsdown-config": "^0.1.1",
    "@systemfsoftware/vitest": "^3.0.0",
    "@systemfsoftware/vitest-config": "^0.1.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:oxlint",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "tstyche": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@systemfsoftware/conformance-spec": "^1.0.1",
    "effect": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@systemfsoftware/conformance-spec": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "provenance": true
  }
}
